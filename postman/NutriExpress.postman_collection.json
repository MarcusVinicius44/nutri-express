  "item": [
    {
      "name": "0. Preparação - apaga pratos de execuções anteriores",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "// remove os pratos existentes para o roteiro começar do zero",
              "pm.response.json().forEach(p => pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}') + '/pratos/' + p.id, method: 'DELETE'}, () => {}));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pratos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pratos"
          ]
        }
      }
    },
    {
      "name": "1. POST /pratos - cria prato vegano (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Retorna o prato criado com id\", () => pm.expect(pm.response.json().id).to.be.a('number'));",
              "pm.test(\"Header Location aponta para o recurso\", () => pm.response.to.have.header('Location'));",
              "pm.collectionVariables.set('idVegano', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
